process {
    withName: EGGNOG {
        cpus = 20
        memory = '128 GB'
        time = '24h'
    }
    withName: BAKTA {
        cpus = 20
        memory = '128 GB'
        time = '24h'
    }
    withName: PROKKA {
        cpus = 20
        memory = '128 GB'
        time = '24h'
    }
    withName: PGAP {
        memory = '128 GB'
        time = '24h'
    }
}
singularity {
    enabled = true
    autoMounts = true
}

process {
    executor = 'slurm'
    queue = 'SP2'
}

executor {
    queueSize = 10
}

params.bakta_db_dir = null
params.eggnog_db_dir = null
params.pgap_dir = null
